---
interface Props {
  vertical?: boolean;
}
const { vertical = false } = Astro.props;

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/archive', label: 'Archive' },
  { href: '/KH_resume.pdf', label: 'Resume', newTab: true },
  { href: '/contact', label: 'Contact' },
];
---

<ul class={vertical ? "flex flex-col gap-6" : "flex gap-6"}>
  {links.map((link) => (
    <li>
      
        <a href={link.href}
        target={link.newTab ? '_blank' : undefined}
        rel={link.newTab ? 'noopener noreferrer' : undefined}
        class="hover:text-blue transition-colors"
      >
        {link.label}
      </a>
    </li>
  ))}
</ul>