---
interface Props {
  vertical?: boolean;
}
const { vertical = false } = Astro.props;

const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
---

<ul class={vertical ? "flex flex-col gap-6" : "flex gap-6"}>
  {links.map((link) => (
    <li>
      <a href={link.href} class="hover:text-blue transition-colors">
        {link.label}
      </a>
    </li>
  ))}
</ul>