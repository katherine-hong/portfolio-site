---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavLinks from '../components/NavLinks.astro';
---

<BaseLayout title="Katherine — Portfolio" showNavLinks={false}>

	<div class="px-20 py-14 max-w-3xl">
		<h1 class="text-4xl font-bold">Hello there!</h1>
		
		<p class="pt-8">
			I’m Katherine, an aspiring software engineer and creative. I’m a senior studying computer science 
			and statistics at the University of Maryland. I’m interested in data analytics, making cool things 
			with code, and exploring the intersection of art and computer science. Currently figuring out when
			the two collide.
		</p>

		<div class="pt-12">
			<NavLinks vertical={true} />
		</div>
		
		<div class="flex items-center gap-4 pt-28">
			<div class="w-10 h-10 rounded-full bg-blue-light flex items-center justify-center text-sm">
				Icon
			</div>
			<a href="/contact" class="hover:text-blue transition-colors pl-4">Say hi</a>
		</div>
	</div>
</BaseLayout>