---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavLinks from '../components/NavLinks.astro';
---

<BaseLayout title="Katherine — Portfolio" showNavLinks={false}>

	<div class="px-20 py-14 max-w-3xl">
		<h1 class="text-4xl font-bold">Hello there!</h1>
		
		<p class="pt-8">
			I’m Katherine, an aspiring software engineer and creative. I’m a senior studying computer science 
			and statistics at the University of Maryland. I’m interested in data analytics, making cool things 
			with code, and exploring the intersection of art and computer science. Let’s see what happens when 
			the two collide!
		</p>

		<div class="pt-12">
			<NavLinks vertical={true} />
		</div>
	</div>
</BaseLayout>