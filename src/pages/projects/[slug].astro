---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project: CollectionEntry<'projects'>) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`Katherine — ${project.data.title}`}>
	<div class="px-20 py-14 max-w-3xl">
		<h1 class="text-4xl font-bold">{project.data.title}</h1>
		<p class="pt-4">{project.data.description}</p>

		<div class="flex flex-wrap gap-2 pt-6">
			{project.data.techStack.map((tech: string) => (
				<span class="text-xs bg-gray-100 rounded-full px-3 py-1">{tech}</span>
			))}
		</div>

		<img src={project.data.image} alt={project.data.title} class="rounded-xl mt-10 w-full" />

		<div class="prose pt-10">
			<Content />
		</div>
	</div>
</BaseLayout>