---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects.js';
---

<BaseLayout title="Katherine — Projects">
	<div class="px-20 py-14">
		<h1 class="text-4xl font-bold">Projects</h1>
		<p class="pt-4">What I've been building, from past internships to passion projects.</p>

		<div class="grid grid-cols-3 gap-8 pt-12">
			{projects.map((project) => (
				<a href={`/projects/${project.slug}`} class="block rounded-2xl overflow-hidden bg-gray-50 border border-gray-200 shadow-md hover:shadow-lg transition-shadow pt-4 px-4">
					<div class="pb-6 min-h-36">
						<h2 class="text-xl font-bold">{project.title}</h2>
						<p class="pt-2 text-sm">{project.description}</p>
					</div>
					<div class="rounded-t-xl bg-blue-light h-64 flex items-center justify-center">
						Picture
					</div>
				</a>
			))}
		</div>
	</div>
</BaseLayout>